{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "callpilot-staging",
  "main": "worker.py",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
